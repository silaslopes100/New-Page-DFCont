# Copy this file to .env and adjust values per environment.
# Never commit the real .env file.

# Enables /docs, /redoc, /openapi.json and DEBUG-level logging. Keep False in production.
DEBUG=False

# SQLAlchemy connection string. Defaults to a local SQLite file if unset.
# Example for Postgres: postgresql+psycopg2://user:password@host:5432/dfcont
DATABASE_URL=sqlite:///./dfcont.db

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://dfcont.com.br
